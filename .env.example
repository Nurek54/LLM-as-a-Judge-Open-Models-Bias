# Skopiuj do .env i uzupełnij (plik .env nie trafia do repo)

# Katalog z binarkami llama.cpp (llama-server, llama-quantize), np. C:\llama.cpp\b1234
LLAMA_CPP_DIR=

# Token HF (modele gated: Bielik, Gemma, Llama - najpierw zaakceptować warunki na stronie modelu)
HF_TOKEN=

# Tłumaczenie LLMBar-PL (scripts/translate_llmbar.py) i opcjonalny sędzia API
OPENAI_API_KEY=
TRANSLATE_BASE_URL=https://api.openai.com/v1
TRANSLATE_MODEL=
TRANSLATE_API_KEY=
# Opcjonalne (zostaw puste, jeśli model ich nie obsługuje):
TRANSLATE_SERVICE_TIER=flex
TRANSLATE_REASONING_EFFORT=none
TRANSLATE_TEMPERATURE=
